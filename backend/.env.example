# Copy this file to .env (cp .env.example .env). Never commit .env.

# 1 = every route returns the fixed JSON in app/mocks/ (default)
# 0 = every route uses the real code (routes not built yet answer 501)
MOCK=1

# Routes that use real code even while MOCK=1, comma separated.
# Names: me, settings, transactions, ask, actions, confirm, demo_spend, demo_reset
# These three are built and read the real SQLite database. Add more as they are built.
# "ask" already works, but add it only together with "actions" and "confirm" (next update):
# until confirm is built, the action ids that live /ask returns cannot be confirmed.
LIVE_ROUTES=me,transactions,demo_reset

# Where the SQLite file lives (leave out to use backend/spendsense.db).
# DATABASE_PATH=spendsense.db

# Turn off the /demo/* routes outside rehearsals and the demo itself.
ENABLE_DEMO_ROUTES=1

# Extra allowed frontend addresses, comma separated.
CORS_ORIGINS=http://localhost:3000

# The AI layer (person C) calls Claude only when this is set. Leave it empty and /ask uses
# its built-in template answers, which need no key and no Wi-Fi. Keep the real key out of git.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
