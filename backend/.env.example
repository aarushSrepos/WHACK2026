# Copy this file to .env (cp .env.example .env). Never commit .env.

# 0 (default) = every route uses the real code: database, engine and AI layer.
# 1 = every route returns the fixed JSON in app/mocks/ (handy for frontend work with no database).
MOCK=0

# Only used with MOCK=1: routes that still use real code, comma separated.
# Names: me, settings, transactions, ask, actions, confirm, demo_spend, demo_reset
LIVE_ROUTES=

# Where the SQLite file lives (leave out to use backend/spendsense.db).
# DATABASE_PATH=spendsense.db

# Turn off the /demo/* routes outside rehearsals and the demo itself.
ENABLE_DEMO_ROUTES=1

# Extra allowed frontend addresses, comma separated.
CORS_ORIGINS=http://localhost:3000

# The AI layer (person C) calls Claude only when this is set. Leave it empty and /ask uses
# its built-in template answers, which need no key and no Wi-Fi. Keep the real key out of git.
# If you set a key, run: pip install -r requirements.txt
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
